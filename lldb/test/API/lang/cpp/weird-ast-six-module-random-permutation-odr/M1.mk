DYLIB_NAME := M1
DYLIB_CXX_SOURCES := M1.cpp
DYLIB_ONLY := YES

# common1.h lands in the build directory (cwd), not in $(SRCDIR)
# where M1.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common1.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M1.o: common1.h
