DYLIB_NAME := M2
DYLIB_CXX_SOURCES := M2.cpp
DYLIB_ONLY := YES

# common2.h lands in the build directory (cwd), not in $(SRCDIR)
# where M2.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common2.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M2.o: common2.h
