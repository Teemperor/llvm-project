DYLIB_NAME := M5
DYLIB_CXX_SOURCES := M5.cpp
DYLIB_ONLY := YES

# common5.h lands in the build directory (cwd), not in $(SRCDIR)
# where M5.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common5.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M5.o: common5.h
