DYLIB_NAME := M3
DYLIB_CXX_SOURCES := M3.cpp
DYLIB_ONLY := YES

# common3.h lands in the build directory (cwd), not in $(SRCDIR)
# where M3.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common3.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M3.o: common3.h
