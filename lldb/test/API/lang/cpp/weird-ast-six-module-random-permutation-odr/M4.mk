DYLIB_NAME := M4
DYLIB_CXX_SOURCES := M4.cpp
DYLIB_ONLY := YES

# common4.h lands in the build directory (cwd), not in $(SRCDIR)
# where M4.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common4.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M4.o: common4.h
