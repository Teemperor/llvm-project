DYLIB_NAME := M6
DYLIB_CXX_SOURCES := M6.cpp
DYLIB_ONLY := YES

# common6.h lands in the build directory (cwd), not in $(SRCDIR)
# where M6.cpp physically lives, so add '-I.' explicitly.
CFLAGS_EXTRAS := -I.

include Makefile.rules

# common6.h is generated by the top-level Makefile (from common.h.in via
# sed) before any of the per-module sub-makes run, but list the dependency
# explicitly anyway so a stale/missing header forces a rebuild.
M6.o: common6.h
