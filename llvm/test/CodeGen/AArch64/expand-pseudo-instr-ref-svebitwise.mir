# RUN: llc -mtriple=aarch64-linux-gnu -mattr=+sve2 -run-pass=aarch64-expand-pseudo -verify-machineinstrs -o - %s | FileCheck %s
#
# Test that AArch64ExpandPseudoImpl::expandSVEBitwisePseudo preserves a
# debug-instr-number on the destructive bitwise op (DOP) it produces.
# DOP defines the original pseudo's destination register, so it's the
# value any DBG_INSTR_REF naming operand 0 of the pseudo will need to
# resolve under InstrRef LiveDebugValues.
#
# Patch under test: AArch64ExpandPseudoInsts.cpp expandSVEBitwisePseudo —
# after constructing the destructive sequence (BSL2N_ZZZZ for EON, etc.),
# copy any peekDebugInstrNum() onto DOP.

# CHECK-LABEL: name: eon_keeps_instrnum
# CHECK: BSL2N_ZZZZ {{.*}}debug-instr-number 21
---
name:            eon_keeps_instrnum
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $z0, $z1

    $z0 = EON_ZZZ $z0, $z1, debug-instr-number 21
    RET_ReallyLR implicit $z0
...
