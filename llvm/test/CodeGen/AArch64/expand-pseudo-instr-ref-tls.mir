# RUN: llc -mtriple=aarch64-unknown-linux-gnu -o - %s \
# RUN:     -run-pass=aarch64-expand-pseudo | FileCheck %s
#
# Test that the AArch64 ADDlowTLS and MOVbaseTLS pseudo expansions
# preserve the debug-instr-number of the original pseudo.
#
# Patches under test (AArch64ExpandPseudoInsts.cpp):
#   * ADDlowTLS now stores its replacement ADDXri in a MachineInstrBuilder
#     and propagates any debug-instr-number to it.
#   * MOVbaseTLS does the same for its replacement MRS.

--- |
  @t = external thread_local global i32
  define ptr @tls_addlowtls() { ret ptr @t }
  define ptr @tls_movbasetls() { ret ptr @t }
...
---
# CHECK-LABEL: name: tls_addlowtls
# CHECK: $x0 = ADDXri $x0, @t, 0, debug-instr-number 13
name: tls_addlowtls
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    $x0 = ADDlowTLS $x0, @t, debug-instr-number 13
    RET_ReallyLR implicit $x0
...
---
# CHECK-LABEL: name: tls_movbasetls
# CHECK: $x0 = MRS {{[0-9]+}}, {{.*}}debug-instr-number 11
name: tls_movbasetls
tracksRegLiveness: true
body:             |
  bb.0:
    $x0 = MOVbaseTLS debug-instr-number 11
    RET_ReallyLR implicit $x0
...
