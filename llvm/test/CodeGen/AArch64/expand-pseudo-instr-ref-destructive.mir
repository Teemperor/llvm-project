# RUN: llc -mtriple=aarch64-linux-gnu -mattr=+sve -run-pass=aarch64-expand-pseudo -o - %s | FileCheck %s
#
# Test that AArch64ExpandPseudoImpl::expand_DestructiveOp preserves a
# debug-instr-number on the destructive-op (DOP) that produces the
# final value of the original pseudo's destination register.  This is
# the value any DBG_INSTR_REF that names operand 0 of the pseudo will
# need to resolve under InstrRef LiveDebugValues.
#
# Patch under test: AArch64ExpandPseudoInsts.cpp expand_DestructiveOp —
# after building the destructive sequence (DOP or MOVPRFX+DOP), copy
# any peekDebugInstrNum() onto DOP.

--- |
  define <vscale x 4 x float> @destructive_keeps_instrnum(<vscale x 4 x i1> %p, <vscale x 4 x float> %a) {
    ret <vscale x 4 x float> %a
  }
...
---
# CHECK-LABEL: name: destructive_keeps_instrnum
# CHECK: $z0 = FADD_ZPmZ_S renamable $p0, killed $z0, renamable $z0, debug-instr-number 7
name: destructive_keeps_instrnum
tracksRegLiveness: true
liveins:
  - { reg: '$p0' }
  - { reg: '$z0' }
body:             |
  bb.0:
    liveins: $p0, $z0

    renamable $z0 = FADD_ZPZZ_S_UNDEF renamable $p0, renamable $z0, killed renamable $z0, debug-instr-number 7
    RET_ReallyLR implicit $z0
...
